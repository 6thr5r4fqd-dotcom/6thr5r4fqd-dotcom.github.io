---
layout: default
---
<article class="post">
  <header class="post-head">
    <h1 class="post-title">{{ page.title }}</h1>
    <div class="post-meta">{{ page.date | date: "%d-%m-%Y" }}</div>

    {% if page.tags.size > 0 %}
      <div class="tag-list post-tags" aria-label="Etiquetas">
        {% for tag in page.tags %}<a class="tag" href="{{ '/' | relative_url }}?etiqueta={{ tag | slugify }}">{{ tag }}</a>{% endfor %}
      </div>
    {% endif %}

    {% if page.image %}
      <img class="post-hero" src="{{ page.image | relative_url }}" alt="Imagen de portada de {{ page.title | escape }}">
    {% endif %}

    {% if page.excerpt %}
      <p class="post-excerpt">{{ page.excerpt }}</p>
    {% endif %}
  </header>

  <div class="post-body">
    {{ content }}
  </div>
</article>
